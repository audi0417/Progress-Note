# Copy to .env and adjust as needed.

DATABASE_URL=sqlite+aiosqlite:///./progress_note.db

# ASR backend: "mock" (default, no GPU/weights needed) or "nemotron" (real
# nvidia/nemotron-3.5-asr-streaming-0.6b model, requires
# `pip install -r requirements-asr.txt` and a CUDA GPU).
ASR_BACKEND=mock
ASR_MODEL_NAME=nvidia/nemotron-3.5-asr-streaming-0.6b
ASR_SAMPLE_RATE=16000
ASR_DEVICE=cuda

# LLM used to turn the final transcript into a structured clinical note.
# Leave ANTHROPIC_API_KEY unset to use the offline fallback summarizer.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
